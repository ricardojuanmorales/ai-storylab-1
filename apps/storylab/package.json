{
  "name": "@ai-storylab/storylab-baseline",
  "private": true,
  "version": "0.8.0-alpha.1",
  "type": "module",
  "description": "Baseline modular verificable de AI StoryLab 1, con cierre de seguridad y accesibilidad y sin vertical slice funcional.",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run src/tests/domain.*.test.ts",
    "test:schemas": "vitest run src/tests/schemas.contract.test.ts",
    "test:parity": "vitest run src/tests/parity.test.ts",
    "test:offline": "vitest run src/tests/offline.guard.test.ts",
    "test:application": "vitest run src/tests/application.*.test.ts",
    "test:adapters": "vitest run src/tests/adapters.*.test.ts",
    "test:accessibility": "vitest run src/tests/domain.accessibility.test.ts src/tests/application.accessibility.test.ts",
    "test:security": "vitest run src/tests/application.safe-error.test.ts",
    "audit:architecture": "node tools/audit-architecture.mjs",
    "audit:secrets": "node tools/audit-secrets.mjs",
    "audit:privacy": "node tools/audit-privacy.mjs",
    "verify": "npm run typecheck && npm run audit:architecture && npm run audit:secrets && npm run audit:privacy && npm run test"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
